USE `knowledge_graph`;
CREATE TAG IF NOT EXISTS `kg_snapshot` (`folder_id` string NOT NULL, `graph_id` string NOT NULL, `snapshot_version` string NOT NULL, `ready` bool NOT NULL DEFAULT false);
CREATE TAG IF NOT EXISTS `enterprise` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `person` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `mortgage_asset` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `pledge_asset` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `creditor` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `risk_event` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `project` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG IF NOT EXISTS `unknown` (`folder_key` fixed_string(64) NOT NULL, `folder_id` string NOT NULL, `name` string NOT NULL, `attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `is_borrower` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `is_guarantor` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `is_pledgor` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `is_mortgagor` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `is_warrantor` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `collateral_for` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `collateral_owned_by` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `spouse_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `kinship_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `legal_representative` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `executive_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `controller_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `shareholder_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `supplier_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `invests_in` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `branch_of` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `loan_to` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `risk_involves` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE EDGE IF NOT EXISTS `credit_from` (`attributes_json` string NOT NULL DEFAULT "{}", `references_json` string NOT NULL DEFAULT "[]");
CREATE TAG INDEX IF NOT EXISTS `i_enterprise_folder_key` ON `enterprise` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_person_folder_key` ON `person` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_mortgage_asset_folder_key` ON `mortgage_asset` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_pledge_asset_folder_key` ON `pledge_asset` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_creditor_folder_key` ON `creditor` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_risk_event_folder_key` ON `risk_event` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_project_folder_key` ON `project` (`folder_key`);
CREATE TAG INDEX IF NOT EXISTS `i_unknown_folder_key` ON `unknown` (`folder_key`);
