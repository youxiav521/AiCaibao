FROM public.ecr.aws/docker/library/python:3.11-slim

# 可选：接受外部 build 时传入代理
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy} https_proxy=${https_proxy}

# 使用国内镜像（清华），覆盖 sources.list，然后更新并安装所需包
RUN printf 'deb http://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free\n\
deb http://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free\n\
deb http://mirrors.tuna.tsinghua.edu.cn/debian-security trixie-security main contrib non-free\n' > /etc/apt/sources.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libreoffice \
      libreoffice-writer \
      fonts-noto-cjk \
      fonts-wqy-zenhei \
      fonts-arphic-uming \
      locales \
      curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install -i https://mirrors.aliyun.com/pypi/simple uv