{
  "openapi": "3.1.0",
  "info": {
    "title": "ADE Jobs API",
    "version": "1.0.0"
  },
  "paths": {
    "/openapi/ade/jobs/submit": {
      "post": {
        "tags": [
          "ADE Jobs"
        ],
        "summary": "提交解析任务",
        "description": "提交一个解析任务，立即返回 job_id，不阻塞解析。若带 file_hash 且已有该 hash 的成功结果，直接返回指向已有结果的 job_id。",
        "operationId": "submit_job_openapi_ade_jobs_submit_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_job_openapi_ade_jobs_submit_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/jobs/{job_id}": {
      "get": {
        "tags": [
          "ADE Jobs"
        ],
        "summary": "查询任务状态",
        "description": "查询指定任务 ID 的状态。job_id 不存在返回 HTTP 404；status 取值 pending / processing / completed / failed。",
        "operationId": "get_status_openapi_ade_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/jobs/{job_id}/data": {
      "get": {
        "tags": [
          "ADE Jobs"
        ],
        "summary": "拉取解析结果",
        "description": "拉取指定任务 ID 的解析结果。未 completed 返回 HTTP 409；job_id 不存在返回 HTTP 404；结果损坏返回 HTTP 500。content_list.content 保持 converted.json 原结构。",
        "operationId": "get_data_openapi_ade_jobs__job_id__data_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/jobs/{job_id}/images/{image_name}": {
      "get": {
        "tags": [
          "ADE Jobs"
        ],
        "summary": "拉取图片",
        "description": "提供指定任务 ID 和图片名称的下载端点，返回图片二进制。未 completed 返回 HTTP 409；job_id 或图片不存在返回 HTTP 404。",
        "operationId": "get_image_openapi_ade_jobs__job_id__images__image_name__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "image_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Image Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "图片二进制流",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "title": "Image Binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_submit_job_openapi_ade_jobs_submit_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "文件本体，流式接收"
          },
          "file_hash": {
            "type": "string",
            "title": "File Hash",
            "description": "文件 sha256，用于幂等去重"
          },
          "external_file_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External File Id",
            "description": "Parsing 侧 file_id，原样透传回 metadata"
          },
          "backend": {
            "type": "string",
            "title": "Backend",
            "description": "解析后端",
            "default": "pipeline/hybrid-http-client"
          },
          "ang": {
            "type": "string",
            "title": "Ang",
            "description": "语言，默认 ch",
            "default": "ch"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "方法，默认 auto",
            "default": "auto"
          },
          "formula_enable": {
            "type": "boolean",
            "title": "Formula Enable",
            "description": "公式识别，默认 true",
            "default": true
          },
          "table_enable": {
            "type": "boolean",
            "title": "Table Enable",
            "description": "表格识别，默认 true",
            "default": true
          },
          "priority": {
            "type": "integer",
            "title": "Priority",
            "description": "优先级，越大越优先，默认 0",
            "default": 0
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "完成/失败时 POST 通知"
          }
        },
        "type": "object",
        "required": [
          "file",
          "file_hash"
        ],
        "title": "Body_submit_job_openapi_ade_jobs_submit_post"
      },
      "ContentListPayload": {
        "properties": {
          "content": {
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "type": "array",
            "title": "Content",
            "description": "converted.json item 数组，结构原样返回",
            "default": []
          }
        },
        "type": "object",
        "title": "ContentListPayload",
        "description": "content_list 载荷：保持现有 converted.json 结构不变。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "图片标识（用于接口 4 下载路径 {image_name}）"
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "图片相对路径，与 content_list item.img_path 对应"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "title": "Size",
            "description": "图片字节数",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "title": "ImageItem",
        "description": "图片清单单项。"
      },
      "ImagesPayload": {
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "title": "Count",
            "description": "图片数量",
            "default": 0
          },
          "list": {
            "items": {
              "$ref": "#/components/schemas/ImageItem"
            },
            "type": "array",
            "title": "List",
            "description": "图片列表；item.img_path 必须与 list[].name 一一对应",
            "default": []
          }
        },
        "type": "object",
        "title": "ImagesPayload",
        "description": "图片清单。"
      },
      "JobDataData": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务 ID"
          },
          "content_list": {
            "$ref": "#/components/schemas/ContentListPayload",
            "description": "converted.json item 数组"
          },
          "images": {
            "$ref": "#/components/schemas/ImagesPayload",
            "description": "图片清单"
          },
          "metadata": {
            "$ref": "#/components/schemas/JobMetadata"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "metadata"
        ],
        "title": "JobDataData",
        "description": "拉取解析结果的 data 载荷。"
      },
      "JobDataResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "响应码，成功统一为 200；业务失败为其他值",
            "default": 200
          },
          "displayMessage": {
            "type": "string",
            "title": "Displaymessage",
            "description": "响应描述；成功为 Operation successful",
            "default": "Operation successful"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobDataData"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "解析结果；未完成时为 null"
          }
        },
        "type": "object",
        "title": "JobDataResponse",
        "description": "GET /openapi/ade/jobs/{job_id}/data 响应体。"
      },
      "JobMetadata": {
        "properties": {
          "external_file_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External File Id",
            "description": "Parsing 侧 file_id，原样透传回来便于对账"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "原始文件名"
          },
          "page_count": {
            "type": "integer",
            "minimum": 0,
            "title": "Page Count",
            "description": "解析页数",
            "default": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "title": "Duration Ms",
            "description": "解析耗时（毫秒）",
            "default": 0
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version",
            "description": "ADE 服务版本号"
          }
        },
        "type": "object",
        "required": [
          "filename"
        ],
        "title": "JobMetadata",
        "description": "任务结果元数据。"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "completed",
          "failed"
        ],
        "title": "JobStatus",
        "description": "ADE Jobs 任务状态枚举。取值固定为 pending / processing / completed / failed，语义不可变更。"
      },
      "JobStatusData": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务 ID"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
            "description": "任务状态"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "失败原因；status=failed 时返回，其他为 null"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "任务进度（0~1），不支持可恒为 0",
            "default": 0.0
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "任务创建时间（ISO8601, UTC）"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "任务最近更新时间（ISO8601, UTC）"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "JobStatusData",
        "description": "查询任务状态的 data 载荷。"
      },
      "JobStatusResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "响应码，成功统一为 200；业务失败为其他值",
            "default": 200
          },
          "displayMessage": {
            "type": "string",
            "title": "Displaymessage",
            "description": "响应描述；成功为 Operation successful",
            "default": "Operation successful"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobStatusData"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "任务状态详情；不存在时为 null"
          }
        },
        "type": "object",
        "title": "JobStatusResponse",
        "description": "GET /openapi/ade/jobs/{job_id} 响应体。"
      },
      "SubmitJobData": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "新创建的任务 ID"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "SubmitJobData",
        "description": "提交解析任务成功后的 data 载荷。"
      },
      "SubmitJobResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "响应码，成功统一为 200；业务失败为其他值",
            "default": 200
          },
          "displayMessage": {
            "type": "string",
            "title": "Displaymessage",
            "description": "响应描述；成功为 Operation successful",
            "default": "Operation successful"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubmitJobData"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "成功时返回 job_id，失败时为 null"
          }
        },
        "type": "object",
        "title": "SubmitJobResponse",
        "description": "POST /openapi/ade/jobs/submit 响应体。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
