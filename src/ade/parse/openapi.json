{
  "openapi": "3.1.0",
  "info": {
    "title": "yusys_ai parse api",
    "version": "2.0.0"
  },
  "paths": {
    "/openapi/ade/upload-file": {
      "post": {
        "tags": [
          "ADE Parse"
        ],
        "summary": "上传文件（仅保存，不解析）",
        "description": "上传文档文件并返回 fileId。",
        "operationId": "upload_file_openapi_ade_upload_file_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_openapi_ade_upload_file_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadFileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/submit-parse-job": {
      "post": {
        "tags": [
          "ADE Parse"
        ],
        "summary": "创建异步解析任务",
        "description": "基于 fileId（或后续扩展字段）提交异步解析任务并返回 jobId。",
        "operationId": "submit_parse_job_openapi_ade_submit_parse_job_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitParseJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitParseJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/parse": {
      "post": {
        "tags": [
          "ADE Parse"
        ],
        "summary": "同步解析文档",
        "description": "同步解析：支持上传文件或 document_url（二选一）。",
        "operationId": "parse_sync_openapi_ade_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_sync_openapi_ade_parse_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/parse/jobs": {
      "get": {
        "tags": [
          "ADE Parse"
        ],
        "summary": "查询异步解析任务列表",
        "description": "分页查询异步任务列表，可按状态过滤。",
        "operationId": "list_parse_jobs_openapi_ade_parse_jobs_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "页码（0-indexed）",
              "default": 0,
              "title": "Page"
            },
            "description": "页码（0-indexed）"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Pagesize"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ParseJobStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/ade/parse/jobs/{job_id}": {
      "get": {
        "tags": [
          "ADE Parse"
        ],
        "summary": "查询异步解析任务状态",
        "description": "根据 job_id 查询任务状态与结果。",
        "operationId": "get_parse_job_openapi_ade_parse_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_parse_sync_openapi_ade_parse_post": {
        "properties": {
          "document": {
            "anyOf": [
              {
                "type": "string",
                "format": "binary"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document",
            "description": "待解析文件（PDF/图片等）；与 document_url 二选一"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "解析模型版本"
          },
          "document_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Url",
            "description": "待解析文件 URL；与 document（二进制上传）二选一"
          },
          "split": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Split",
            "description": "分段策略，可选 page"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "加密文件密码（仅加密文件需要）"
          }
        },
        "type": "object",
        "title": "Body_parse_sync_openapi_ade_parse_post"
      },
      "Body_upload_file_openapi_ade_upload_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "待上传文件（如 pdf/docx/pptx/md/txt/xlsx/csv/png/jpg/jpeg）"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_openapi_ade_upload_file_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务 ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "任务状态"
          },
          "received_at": {
            "type": "integer",
            "title": "Received At",
            "description": "任务接收时间戳"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "任务进度，0~1"
          },
          "org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id",
            "description": "组织 ID"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version",
            "description": "版本"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParseResponse"
              },
              {
                "$ref": "#/components/schemas/SpreadsheetParseResponse"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "任务完成且未指定 output_save_url 时的输出结果"
          },
          "output_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Url",
            "description": "结果下载链接（大结果或指定 output_save_url 时返回）"
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParseMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "文档 parse 元信息（文件类 parse 场景）"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason",
            "description": "失败原因"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "received_at",
          "progress"
        ],
        "title": "JobStatusResponse",
        "description": "ADE Get Parse Jobs 统一响应体（200）。\n\ndata 可能是 ParseResponse、SpreadsheetParseResponse 或 null。"
      },
      "JobSummary": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务 ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "任务状态"
          },
          "received_at": {
            "type": "integer",
            "title": "Received At",
            "description": "任务接收时间戳"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "任务进度（0~1）"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason",
            "description": "失败原因"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "received_at",
          "progress"
        ],
        "title": "JobSummary",
        "description": "JobsListResponse.jobs[] 单项摘要。"
      },
      "JobsListResponse": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array",
            "title": "Jobs",
            "description": "任务列表"
          },
          "org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id",
            "description": "组织 ID"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "description": "是否存在下一页",
            "default": false
          }
        },
        "type": "object",
        "title": "JobsListResponse",
        "description": "ADE List Parse Jobs 响应体。"
      },
      "NonTableCellGroundingType": {
        "type": "string",
        "enum": [
          "chunkLogo",
          "chunkCard",
          "chunkAttestation",
          "chunkScanCode",
          "chunkForm",
          "chunkTable",
          "chunkFigure",
          "chunkText",
          "chunkMarginalia",
          "chunkTitle",
          "chunkPageHeader",
          "chunkPageFooter",
          "chunkPageNumber",
          "chunkKeyValue",
          "table"
        ],
        "title": "NonTableCellGroundingType"
      },
      "ParseChunk": {
        "properties": {
          "markdown": {
            "type": "string",
            "title": "Markdown",
            "description": "该块对应 Markdown 片段"
          },
          "type": {
            "$ref": "#/components/schemas/ParseChunkType",
            "description": "语义块类型：text/table/marginalia/figure 及 DPT-2 专有 logo/card/attestation/scan_code 等（见 ParseChunkType）"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "块唯一 id，用于 splits.chunks 与 grounding 键引用"
          },
          "grounding": {
            "$ref": "#/components/schemas/ParseChunkGrounding"
          }
        },
        "type": "object",
        "required": [
          "markdown",
          "type",
          "id",
          "grounding"
        ],
        "title": "ParseChunk",
        "description": "语义块（ParseChunk）"
      },
      "ParseChunkGrounding": {
        "properties": {
          "box": {
            "$ref": "#/components/schemas/ParseGroundingBox"
          },
          "page": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page",
            "description": "页码，从 0 开始"
          }
        },
        "type": "object",
        "required": [
          "box",
          "page"
        ],
        "title": "ParseChunkGrounding",
        "description": "chunk.grounding：无 type/confidence，仅定位"
      },
      "ParseChunkType": {
        "type": "string",
        "enum": [
          "text",
          "table",
          "marginalia",
          "figure",
          "logo",
          "card",
          "attestation",
          "scan_code",
          "title"
        ],
        "title": "ParseChunkType",
        "description": "ADE Parse 响应 chunks[].type（与官方 chunk type 字符串一致）"
      },
      "ParseGroundingBox": {
        "properties": {
          "left": {
            "type": "number",
            "title": "Left",
            "description": "左边界"
          },
          "top": {
            "type": "number",
            "title": "Top",
            "description": "上边界"
          },
          "right": {
            "type": "number",
            "title": "Right",
            "description": "右边界"
          },
          "bottom": {
            "type": "number",
            "title": "Bottom",
            "description": "下边界"
          }
        },
        "type": "object",
        "required": [
          "left",
          "top",
          "right",
          "bottom"
        ],
        "title": "ParseGroundingBox",
        "description": "版面矩形框，左上-右下"
      },
      "ParseJobStatus": {
        "type": "string",
        "enum": [
          "cancelled",
          "completed",
          "failed",
          "pending",
          "processing"
        ],
        "title": "ParseJobStatus",
        "description": "List Parse Jobs 状态过滤值。"
      },
      "ParseLowConfidenceSpan": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "低置信子串文本"
          },
          "span": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Span",
            "description": "在文本中的区间 [start, end]，含义以官方 API 为准"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "该子串置信度"
          }
        },
        "type": "object",
        "required": [
          "text",
          "span",
          "confidence"
        ],
        "title": "ParseLowConfidenceSpan",
        "description": "low_confidence_spans 单项（Patch）"
      },
      "ParseMetadata": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "原始文件名"
          },
          "org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id",
            "description": "组织 id，可为 null"
          },
          "page_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page Count"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Ms",
            "description": "耗时（毫秒）"
          },
          "credit_usage": {
            "type": "number",
            "title": "Credit Usage",
            "description": "额度消耗"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务 id"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version",
            "description": "解析模型/服务版本"
          },
          "failed_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Failed Pages",
            "description": "解析失败的页码列表"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "page_count",
          "duration_ms",
          "credit_usage",
          "job_id"
        ],
        "title": "ParseMetadata",
        "description": "解析任务元数据"
      },
      "ParseResponse": {
        "properties": {
          "markdown": {
            "type": "string",
            "title": "Markdown",
            "description": "整篇文档 Markdown"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/ParseChunk"
            },
            "type": "array",
            "title": "Chunks",
            "description": "语义块列表"
          },
          "splits": {
            "items": {
              "$ref": "#/components/schemas/ParseSplit"
            },
            "type": "array",
            "title": "Splits",
            "description": "分段列表，常与 split=page 对应"
          },
          "grounding": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ParseResponseGrounding"
                },
                {
                  "$ref": "#/components/schemas/ParseResponseTableCellGrounding"
                }
              ]
            },
            "type": "object",
            "title": "Grounding",
            "description": "id -> 版面证据；键为 chunk id 或 tableCell id（如 0-u）"
          },
          "metadata": {
            "$ref": "#/components/schemas/ParseMetadata"
          }
        },
        "type": "object",
        "required": [
          "markdown",
          "metadata"
        ],
        "title": "ParseResponse",
        "description": "ADE Parse 200 响应体形状（与 extract/schema/parse_response.json 一致）。\n\n官方字段定义见：ADE Parse OpenAPI — ParseResponse。"
      },
      "ParseResponseGrounding": {
        "properties": {
          "box": {
            "$ref": "#/components/schemas/ParseGroundingBox"
          },
          "page": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page"
          },
          "type": {
            "$ref": "#/components/schemas/NonTableCellGroundingType",
            "description": "普通 grounding 类型（不含 tableCell）"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence",
            "description": "可选置信度"
          },
          "low_confidence_spans": {
            "items": {
              "$ref": "#/components/schemas/ParseLowConfidenceSpan"
            },
            "type": "array",
            "title": "Low Confidence Spans",
            "description": "低置信片段"
          }
        },
        "type": "object",
        "required": [
          "box",
          "page",
          "type"
        ],
        "title": "ParseResponseGrounding",
        "description": "ParseResponseGrounding：普通块 grounding（非 tableCell）。"
      },
      "ParseResponseTableCellGrounding": {
        "properties": {
          "box": {
            "$ref": "#/components/schemas/ParseGroundingBox"
          },
          "page": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page"
          },
          "type": {
            "type": "string",
            "const": "tableCell",
            "title": "Type",
            "description": "固定为 tableCell"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence",
            "description": "可选置信度"
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParseResponseTableCellGroundingPosition"
              },
              {
                "type": "null"
              }
            ],
            "description": "tableCell 在表中的位置（官方定义为可空）"
          }
        },
        "type": "object",
        "required": [
          "box",
          "page",
          "type"
        ],
        "title": "ParseResponseTableCellGrounding",
        "description": "ParseResponseTableCellGrounding：tableCell grounding。"
      },
      "ParseResponseTableCellGroundingPosition": {
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Row"
          },
          "col": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Col"
          },
          "rowspan": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rowspan"
          },
          "colspan": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Colspan"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "所属表格 chunk 的 id"
          }
        },
        "type": "object",
        "required": [
          "row",
          "col",
          "rowspan",
          "colspan",
          "chunk_id"
        ],
        "title": "ParseResponseTableCellGroundingPosition",
        "description": "tableCell 在表格中的位置"
      },
      "ParseSplit": {
        "properties": {
          "class": {
            "type": "string",
            "title": "Class",
            "description": "分段类型，如 page"
